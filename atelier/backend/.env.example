# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4001
JWT_SECRET=change_me_to_a_long_random_string
FRONTEND_URL=http://localhost:5174
PUBLIC_URL=http://localhost:4001

# ── Splits (basis points of the buyer's commission price) ────────────────────
# Photographer royalty and platform fee. Painter receives the remainder.
PHOTOGRAPHER_ROYALTY_BPS=1000
PLATFORM_FEE_BPS=1500

# ── Escrow ───────────────────────────────────────────────────────────────────
# Days after delivery before the buyer's acceptance is assumed and escrow releases.
AUTO_ACCEPT_DAYS=7

# ── Stripe Connect ───────────────────────────────────────────────────────────
# Leave STRIPE_SECRET_KEY empty to run the built-in ledger simulator instead.
# The whole commission flow (escrow, splits, payouts, 1099 totals) works either way.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Tax reporting ────────────────────────────────────────────────────────────
# 1099-NEC filing threshold in cents. The OBBBA raised this from $600 to $2,000
# for payments made after 2025-12-31. Confirm the current figure with a CPA.
TAX_1099_NEC_THRESHOLD_CENTS=200000
TAX_1099_NEC_THRESHOLD_CENTS_PRE_2026=60000

# ── Registry signing key (Ed25519, PKCS#8 PEM) ───────────────────────────────
# Generated into ./data/registry-key.pem on first boot if unset. Set explicitly
# in production so certificates survive a redeploy.
REGISTRY_PRIVATE_KEY=
